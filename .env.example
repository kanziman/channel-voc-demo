# Channel VOC Intelligence Dept — environment template
# Copy to .env and fill values. .env is gitignored (never commit real keys).
# The plugin itself is a model-agnostic markdown skill; the runtime model is the
# host agent (Codex/Claude), so NO LLM API key is required to run the skills.

# ── GitHub dispatch (Triage/QA arm → real Issue + PR) ────────────────────────
# Auth is handled by the `gh` CLI (run `gh auth status`). Skills shell out to gh,
# so a raw token here is optional. Set GITHUB_TOKEN only for non-gh environments.
GITHUB_TEST_REPO=kanziman/channel-voc-demo
# GITHUB_TOKEN=            # optional; prefer `gh auth login`

# ── Data source (Listen arm → public real CS conversations) ──────────────────
# Option chosen: HuggingFace no-auth direct download (no credentials needed).
# Bitext Customer Support dataset; reconstructed into ChannelTalk format.
HF_DATASET=bitext/Bitext-customer-support-llm-chatbot-training-dataset
# KAGGLE_USERNAME=         # only if switching to the Kaggle source
# KAGGLE_KEY=              # (place ~/.kaggle/kaggle.json instead if using Kaggle)

# ── ChannelTalk Open API (optional — deferred) ───────────────────────────────
# For end-to-end seeding of a test workspace. Not needed for the first outputs.
# CHANNEL_ACCESS_KEY=
# CHANNEL_ACCESS_SECRET=

# ── Safety ───────────────────────────────────────────────────────────────────
# Auto-dispatch requires human approval by default; confidence below threshold
# routes to a review queue (handoff §7).
DISPATCH_REQUIRE_APPROVAL=true
DISPATCH_CONFIDENCE_THRESHOLD=0.7
